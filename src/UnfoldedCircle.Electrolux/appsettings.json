{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "UnfoldedCircle.Server": "Trace",
      "UnfoldedCircle.Electrolux": "Trace",
      "Makaretu.Dns": "Warning",
      "System.Net.Http.HttpClient": "Error"
    },
    "Console": {
      "FormatterName": "Simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffK ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Electrolux": {
    "AppliancesEndpoint": "https://api.developer.electrolux.one/api/v1/appliances",
    "RefreshTokenEndpoint": "https://api.developer.electrolux.one/api/v1/token/refresh"
  }
}
